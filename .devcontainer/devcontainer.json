{
    "name": "isaac-lab-klask-rl:local",
    "image": "isaac-lab-klask-rl:local",
    "runArgs": [
        "--rm",
        "--gpus=\"device=3\"",
        "--network=host",
        "--name=isaac-lab-klask-rl-devcontainer",
        "--env-file=.devcontainer/devcontainer.env"
    ],
    "containerEnv": {
        "ACCEPT_EULA": "Y",
        "PRIVACY_CONSENT": "Y",
        "DISPLAY": "${localEnv:DISPLAY}",
        "LIVESTREAM": "1",
        "HISTFILE": "/root/.shell_history/.bash_history"
    },
    "mounts": [
        "source=${localEnv:HOME}/.Xauthority,target=/root/.Xauthority,type=bind",
        "source=isaac-lab-klask-rl-devcontainer_cache_kit,target=/isaac-sim/kit/cache,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_cache_ov,target=/root/.cache/ov,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_cache_pip,target=/root/.cache/pip,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_cache_glcache,target=/root/.cache/nvidia/GLCache,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_cache_computecache,target=/root/.nv/ComputeCache,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_logs,target=/root/.nvidia-omniverse/logs,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_data,target=/root/.local/share/ov/data,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_documents,target=/root/Documents,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_claude,target=/root/.claude,type=volume",
        "source=isaac-lab-klask-rl-devcontainer_shell_history,target=/root/.shell_history,type=volume",
        "source=${localWorkspaceFolder}/src/klask_rl,target=/workspace/klask_rl,type=bind",
        "source=${localWorkspaceFolder}/third_party/dreamerv3-torch,target=/workspace/klask_rl/scripts/dreamer/dreamerv3torch,type=bind",
        "source=${localWorkspaceFolder}/third_party/r2dreamer,target=/workspace/klask_rl/scripts/dreamer/r2dreamer,type=bind",
        "source=${localWorkspaceFolder}/third_party/fast_sac,target=/workspace/klask_rl/scripts/fast_sac,type=bind"
    ],
    "workspaceFolder": "/workspace/klask_rl",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-python.flake8",
                "ms-python.isort",
                "redhat.vscode-yaml",
                "streetsidesoftware.code-spell-checker",
                "anthropic.claude-code"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "python.linting.enabled": true,
                "python.linting.flake8Enabled": true,
                "python.linting.pylintEnabled": false,
                "python.defaultInterpreterPath": "/workspace/isaaclab/_isaac_sim/python.sh",
                "black-formatter.args": [
                    "--line-length=120",
                    "--unstable"
                ],
                "[json]": {
                    "editor.defaultFormatter": "vscode.json-language-features"
                },
                "[jsonc]": {
                    "editor.defaultFormatter": "vscode.json-language-features"
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml"
                },
                "isort.args": [
                    "--profile",
                    "black",
                    "--filter-files"
                ],
                "python.analysis.extraPaths": [
                    "/workspace/isaaclab/source/isaaclab",
                    "/workspace/isaaclab/source/isaaclab_rl",
                    "/workspace/isaaclab/source/isaaclab_assets",
                    "/workspace/isaaclab/source/isaaclab_mimic",
                    "/workspace/isaaclab/source/isaaclab_tasks",
                    "/workspace/isaaclab/_isaac_sim/exts/omni.isaac.ml_archive/pip_prebundle",
                    "/workspace/isaaclab/_isaac_sim/exts/omni.isaac.core_archive/pip_prebundle",
                    "/workspace/isaaclab/_isaac_sim/extscache/omni.kit.pip_archive-0.0.0+69cbf6ad.lx64.cp311/pip_prebundle",
                    "/workspace/isaaclab/_isaac_sim/exts/omni.pip.compute/pip_prebundle",
                    "/workspace/klask_rl/source/klask_rl",
                    "/workspace/klask_rl/scripts/dreamer/r2dreamer",
                    "/workspace/klask_rl/scripts/fast_sac"
                ]
            }
        }
    },
    "postStartCommand": "bash /entrypoint.sh"
}